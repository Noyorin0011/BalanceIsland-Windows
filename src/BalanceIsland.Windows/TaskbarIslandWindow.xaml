<Window x:Class="BalanceIsland.Windows.TaskbarIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310" Height="28" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True">
    <Border x:Name="IslandBorder" Background="#E61A1F26" CornerRadius="5"
            BorderBrush="#55657380" BorderThickness="1" Padding="7,1"
            MouseLeftButtonUp="Island_LeftClick" MouseRightButtonUp="Island_RightClick"
            ToolTip="单击切换账户；右键打开设置">
        <TextBlock x:Name="IslandText" Foreground="White" FontFamily="Segoe UI"
                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="Balance Island" />
    </Border>
</Window>
