<Window x:Class="BalanceIsland.Windows.TaskbarIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="310" Height="28" MinWidth="160" MinHeight="24" MaxWidth="720" MaxHeight="80"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True">
    <Border x:Name="IslandBorder" Background="{DynamicResource IslandBackground}" CornerRadius="5"
            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="7,1"
            MouseLeftButtonDown="Island_MouseLeftButtonDown" MouseLeftButtonUp="Island_LeftClick"
            MouseRightButtonUp="Island_RightClick"
            ToolTip="正常模式不拦截任务栏点击；开启编辑后可拖动和缩放">
        <TextBlock x:Name="IslandText" Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI"
                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Text="Balance Island" />
    </Border>
</Window>
