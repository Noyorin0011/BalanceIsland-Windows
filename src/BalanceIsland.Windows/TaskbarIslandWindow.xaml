<Window x:Class="BalanceIsland.Windows.TaskbarIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Width="225" Height="38" MinWidth="160" MinHeight="28" MaxWidth="480" MaxHeight="100"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ProviderIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="IslandSurface" Background="Transparent" Margin="1"
          PreviewMouseLeftButtonDown="IslandSurface_MouseLeftButtonDown"
          ToolTip="已锁定并允许鼠标穿透">
        <Grid.Effect>
            <DropShadowEffect Color="#D0000000" BlurRadius="2" ShadowDepth="1" Opacity="0.9" />
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ProviderIconBackground" Grid.Column="0" Width="22" Height="22"
                CornerRadius="7" Background="Transparent" HorizontalAlignment="Center">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=VerticalLayout, Path=Visibility}" Value="Visible">
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="Margin" Value="0,3,0,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Image x:Name="ProviderIconImage" Width="17" Height="17" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="ProviderIconFallbackText" Text="+" Foreground="#10131A"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Margin" Value="3,0,0,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=VerticalLayout, Path=Visibility}" Value="Visible">
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="2" />
                            <Setter Property="Margin" Value="1,28,1,2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="IslandTitleText" Grid.Row="0" Foreground="{DynamicResource PrimaryText}"
                       FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Text="Balance Island" />
            <TextBlock x:Name="IslandUsageText" Grid.Row="1" Foreground="{DynamicResource PrimaryText}" Opacity="0.86"
                       FontFamily="Segoe UI" FontSize="10" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Text="请添加账户" />
            <!-- Vertical taskbar: icon is moved above these three text rows by the styles above. -->
            <StackPanel x:Name="VerticalLayout" Grid.RowSpan="2" VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" Visibility="Collapsed">
                <TextBlock x:Name="VerticalLabelText" Foreground="{DynamicResource PrimaryText}"
                           FontFamily="Segoe UI" FontSize="10" FontWeight="SemiBold"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="" />
                <TextBlock x:Name="VerticalBalanceText" Foreground="{DynamicResource PrimaryText}"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="" />
                <TextBlock x:Name="VerticalUsageText" Foreground="{DynamicResource PrimaryText}" Opacity="0.86"
                           FontFamily="Segoe UI" FontSize="9" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="" />
            </StackPanel>
        </Grid>

        <Grid x:Name="EditChrome" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border BorderBrush="#A0FFFFFF" BorderThickness="1" CornerRadius="2"
                    IsHitTestVisible="False" />
            <primitives:Thumb Tag="Left" Width="6" HorizontalAlignment="Left"
                              Cursor="SizeWE" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <primitives:Thumb Tag="Right" Width="6" HorizontalAlignment="Right"
                              Cursor="SizeWE" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <primitives:Thumb Tag="Top" Height="6" VerticalAlignment="Top"
                              Cursor="SizeNS" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <primitives:Thumb Tag="Bottom" Height="6" VerticalAlignment="Bottom"
                              Cursor="SizeNS" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <primitives:Thumb Tag="TopLeft" Width="9" Height="9" HorizontalAlignment="Left"
                              VerticalAlignment="Top" Cursor="SizeNWSE" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <primitives:Thumb Tag="TopRight" Width="9" Height="9" HorizontalAlignment="Right"
                              VerticalAlignment="Top" Cursor="SizeNESW" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <primitives:Thumb Tag="BottomLeft" Width="9" Height="9" HorizontalAlignment="Left"
                              VerticalAlignment="Bottom" Cursor="SizeNESW" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
            <primitives:Thumb Tag="BottomRight" Width="9" Height="9" HorizontalAlignment="Right"
                              VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Transparent"
                              DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted" />
        </Grid>
    </Grid>
</Window>