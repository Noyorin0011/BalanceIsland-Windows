<Window x:Class="BalanceIsland.Windows.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑账户" Width="470" Height="500" MinWidth="420" MinHeight="465"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="编辑账户" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Provider" />
            <TextBox x:Name="ProviderTextBox" IsReadOnly="True" IsTabStop="False" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="账户备注" />
            <TextBox x:Name="LabelTextBox" />
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="API Key" />
            <Grid Margin="0,4,0,10">
                <PasswordBox x:Name="ApiKeyBox" Padding="8,6" Margin="0"
                             PasswordChanged="ApiKeyBox_PasswordChanged"
                             ToolTip="留空以使用旧API" />
                <TextBlock x:Name="ApiKeyPlaceholder" Text="留空以使用旧API"
                           Foreground="{DynamicResource SecondaryText}" Opacity="0.78"
                           Margin="9,0,0,0" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="手动余额" />
                <TextBox x:Name="ManualBalanceTextBox" ToolTip="留空表示不覆盖接口余额" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="刷新分钟" />
                <TextBox x:Name="RefreshMinutesTextBox" ToolTip="留空或 0 使用 Provider 默认值" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,4,0,12">
            <CheckBox x:Name="ShowInIslandBox" Content="在浮岛显示" />
            <TextBlock x:Name="ShowInIslandHelpText"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock Text="输入新的 API Key 后，凭据会写入 Windows 凭据管理器；留空则保留旧 API 来源。"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="82" />
            <Button Content="保存" IsDefault="True" Click="Save_Click" MinWidth="82" />
        </StackPanel>
    </Grid>
</Window>
