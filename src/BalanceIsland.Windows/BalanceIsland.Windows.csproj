<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BalanceIsland</AssemblyName>
    <RootNamespace>BalanceIsland.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- This is a WPF process that uses WinForms only for NotifyIcon. WPF per-monitor DPI
         awareness is intentionally declared in app.manifest, so WFAC010 is not actionable. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon />
    <Version>0.3.0</Version>
    <Authors>Noyorin0011</Authors>
    <Description>Windows taskbar island for AI API balances, usage and alerts.</Description>
  </PropertyGroup>
</Project>
