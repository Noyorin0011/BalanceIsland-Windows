<Window x:Class="BalanceIsland.Windows.EnvironmentImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入环境 API 凭据" Width="860" Height="500" MinWidth="720" MinHeight="380"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="发现的环境 API 凭据" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="扫描不会自动导入。请选择要添加的项目；完整 API Key 不会显示或写入配置。"
                       Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="CandidatesGrid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="{DynamicResource CardBackground}" BorderThickness="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAlreadyImported}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="导入" Width="58">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="环境变量" Binding="{Binding VariableName}" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Header="作用域" Binding="{Binding Scope}" IsReadOnly="True" Width="80" />
                <DataGridTemplateColumn Header="Provider" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ProviderOptions}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Provider"
                                      SelectedValue="{Binding SelectedProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Key 后缀" Binding="{Binding MaskedKey}" IsReadOnly="True" Width="105" />
                <DataGridTextColumn Header="匹配原因" Binding="{Binding MatchReason}" IsReadOnly="True" Width="110" />
                <DataGridTextColumn Header="状态" Binding="{Binding State}" IsReadOnly="True" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="86" />
            <Button Content="导入所选" Click="Import_Click" IsDefault="True" MinWidth="96" />
        </StackPanel>
    </Grid>
</Window>
