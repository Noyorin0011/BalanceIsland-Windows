<Window x:Class="BalanceIsland.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Balance Island" Width="980" Height="760" MinWidth="820" MinHeight="620"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Balance Island" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Windows 任务栏 AI API 余额监控 · v0.4.0"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="账户 / API">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="账户 / API" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="添加 Provider 与 API Key。手动输入的 Key 只写入 Windows 凭据管理器，不写入配置 JSON。"
                                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Provider" />
                                <TextBox x:Name="ProviderSearchBox" TextChanged="ProviderSearchBox_TextChanged"
                                         ToolTip="可搜索名称、别名、环境变量名、Key 前缀或限制说明" />
                                <ComboBox x:Name="ProviderBox" DisplayMemberPath="DisplayName" SelectedValuePath="Provider"
                                          Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="账户备注" />
                                <TextBox x:Name="LabelBox" ToolTip="留空时显示安全 Key 后缀；短 Key 仅显示占位符" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="API Key" />
                                <PasswordBox x:Name="ApiKeyBox" Padding="8,6" Margin="0,4,0,10" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="手动余额" />
                                <TextBox x:Name="ManualBalanceBox" ToolTip="可选；用于无余额接口的 Provider" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Margin="0,0,10,0">
                                <TextBlock Text="刷新分钟" />
                                <TextBox x:Name="RefreshMinutesBox" Text="0" ToolTip="0 使用 Provider 建议值" />
                            </StackPanel>
                            <Button Grid.Column="5" Content="添加账户" Click="AddAccount_Click" VerticalAlignment="Center" MinWidth="94" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="AccountsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                              SelectionUnit="FullRow" Background="{DynamicResource CardBackground}" BorderThickness="0"
                              SelectionChanged="AccountsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="125" />
                            <DataGridTextColumn Header="账户" Binding="{Binding Label}" Width="150" />
                            <DataGridTextColumn Header="凭据来源" Binding="{Binding Source}" Width="190" />
                            <DataGridTextColumn Header="余额 / 状态" Binding="{Binding Primary}" Width="145" />
                            <DataGridTextColumn Header="详情" Binding="{Binding Secondary}" Width="*" />
                            <DataGridTextColumn Header="刷新时间" Binding="{Binding Updated}" Width="125" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="EnableAccountButton" Content="启用/停用" Click="ToggleSelectedAccount_Click"
                                IsEnabled="False" MinWidth="92" />
                        <Button x:Name="EditAccountButton" Content="编辑" Click="EditSelectedAccount_Click"
                                IsEnabled="False" MinWidth="76" />
                        <Button x:Name="DeleteAccountButton" Click="DeleteSelected_Click"
                                IsEnabled="False" MinWidth="92">
                            <TextBlock Text="删除所选" Foreground="{DynamicResource DangerText}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="余额告警">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="余额告警" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="余额通知仅在进入预警或临界区间时触发；可选异常大幅变动检测并带冷却时间。"
                                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,14" />
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="配置账户" />
                                <ComboBox x:Name="AlertAccountBox" DisplayMemberPath="Display" SelectedValuePath="Id"
                                          SelectionChanged="AlertAccountBox_SelectionChanged" Margin="0,4,0,12" />
                                <CheckBox x:Name="AlertEnabledBox" Content="启用余额告警" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <StackPanel Width="210" Margin="0,0,12,10">
                                        <TextBlock Text="警告线" />
                                        <TextBox x:Name="WarningLineBox" ToolTip="余额低于该值进入严重告警" />
                                    </StackPanel>
                                </WrapPanel>
                                <CheckBox x:Name="AnomalyEnabledBox" Content="启用异常余额变动检测" Margin="0,4,0,10" />
                                <WrapPanel>
                                    <StackPanel Width="180" Margin="0,0,12,10">
                                        <TextBlock Text="绝对变动阈值" />
                                        <TextBox x:Name="AnomalyThresholdBox" />
                                    </StackPanel>
                                    <StackPanel Width="180" Margin="0,0,12,10">
                                        <TextBlock Text="百分比阈值 (%)" />
                                        <TextBox x:Name="AnomalyPercentBox" />
                                    </StackPanel>
                                    <StackPanel Width="180" Margin="0,0,12,10">
                                        <TextBlock Text="判定方式" />
                                        <ComboBox x:Name="AnomalyModeBox" DisplayMemberPath="Display" SelectedValuePath="Value" />
                                    </StackPanel>
                                    <StackPanel Width="180" Margin="0,0,12,10">
                                        <TextBlock Text="冷却分钟" />
                                        <TextBox x:Name="AnomalyCooldownBox" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="保存后会重置该账户的告警参考状态，避免旧阈值继续触发。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                <Button Content="保存告警设置" Click="SaveAlert_Click" HorizontalAlignment="Right" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="显示与外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="显示与外观" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="主题和调色板即时应用；分组决定浮岛显示哪些账户。"
                                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="应用主题" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="用途：统一设置窗口、对话框和原生标题栏的明暗外观。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <TextBlock Text="使用：在下拉列表选择跟随系统、浅色或深色；高对比度始终由 Windows 优先处理。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ComboBox x:Name="ThemeModeBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectionChanged="ThemeModeBox_SelectionChanged" Width="220" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="浮岛配色" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="用途：按余额状态为浮岛文字着色，方便快速辨认风险。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <TextBlock Text="使用：选择 5 套预设之一，或选择自定义并填写四个颜色后保存。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ComboBox x:Name="IslandPaletteBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                                          SelectionChanged="IslandPaletteBox_SelectionChanged" Width="220" HorizontalAlignment="Left" />
                                <StackPanel x:Name="CustomColorFieldsPanel" Margin="0,4,0,0">
                                    <TextBlock Text="使用 #RRGGBB 或 #AARRGGBB；预览反映当前输入，保存后才会应用。"
                                               Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <WrapPanel>
                                        <StackPanel Width="175" Margin="0,0,12,0">
                                            <TextBlock Text="正常" />
                                            <TextBox x:Name="CustomNormalColorBox" TextChanged="CustomColorBox_TextChanged" />
                                            <Border x:Name="CustomNormalColorPreview" Height="10" CornerRadius="3" Margin="0,-6,0,10" />
                                        </StackPanel>
                                        <StackPanel Width="175" Margin="0,0,12,0">
                                            <TextBlock Text="异常" />
                                            <TextBox x:Name="CustomAnomalyColorBox" TextChanged="CustomColorBox_TextChanged" />
                                            <Border x:Name="CustomAnomalyColorPreview" Height="10" CornerRadius="3" Margin="0,-6,0,10" />
                                        </StackPanel>
                                        <StackPanel Width="175" Margin="0,0,12,0">
                                            <TextBlock Text="预警" />
                                            <TextBox x:Name="CustomWarning15ColorBox" TextChanged="CustomColorBox_TextChanged" />
                                            <Border x:Name="CustomWarning15ColorPreview" Height="10" CornerRadius="3" Margin="0,-6,0,10" />
                                        </StackPanel>
                                        <StackPanel Width="175">
                                            <TextBlock Text="临界" />
                                            <TextBox x:Name="CustomCriticalColorBox" TextChanged="CustomColorBox_TextChanged" />
                                            <Border x:Name="CustomCriticalColorPreview" Height="10" CornerRadius="3" Margin="0,-6,0,10" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <Button Content="保存自定义颜色" Click="SaveCustomColors_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="浮岛显示分组" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="用途：控制浮岛轮播哪些账户，或汇总同一 Provider 的多个账户。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <TextBlock Text="使用：选择账户并保存；轮播可混合 Provider，聚合仅允许同一 Provider，随后设为活动分组。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="现有分组" />
                                        <ComboBox x:Name="DisplayGroupBox" DisplayMemberPath="Display" SelectedValuePath="Id"
                                                  SelectionChanged="DisplayGroupBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="分组名称" />
                                        <TextBox x:Name="DisplayGroupNameBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="显示方式" />
                                        <ComboBox x:Name="DisplayGroupModeBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectionChanged="DisplayGroupSelection_Changed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="选择账户（可多选）" Margin="0,2,0,4" />
                                <ListBox x:Name="DisplayGroupAccountsList" DisplayMemberPath="Display" SelectionMode="Multiple"
                                         SelectionChanged="DisplayGroupSelection_Changed" Height="110"
                                         Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" />
                                <CheckBox x:Name="DisplayGroupIncludePlanBox" Content="包含 ChatGPT/Codex 套餐余量"
                                          Checked="DisplayGroupIncludePlan_Changed" Unchecked="DisplayGroupIncludePlan_Changed" Margin="0,6,0,0" />
                                <TextBlock x:Name="DisplayGroupValidationText" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="ActiveDisplayGroupStatusText" Foreground="{DynamicResource SecondaryText}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="新建" Click="NewDisplayGroup_Click" />
                                    <Button x:Name="SaveDisplayGroupButton" Content="保存分组" Click="SaveDisplayGroup_Click" />
                                    <Button x:Name="DeleteDisplayGroupButton" Content="删除分组" Click="DeleteDisplayGroup_Click" />
                                    <Button x:Name="SetActiveDisplayGroupButton" Content="设为活动分组" Click="SetActiveDisplayGroup_Click" />
                                    <Button x:Name="ClearActiveDisplayGroupButton" Content="停用分组，使用默认账户显示"
                                            Click="ClearActiveDisplayGroup_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="位置 / 尺寸" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="用途：调整浮岛在任务栏附近的位置和大小。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,10" />
                                <TextBlock Text="使用：选择预设，或开启编辑后拖动、缩放；关闭编辑后浮岛固定并鼠标穿透。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="浮岛显示模式" VerticalAlignment="Center" />
                                    <ComboBox x:Name="IslandModeBox" Grid.Column="1" Margin="12,0" DisplayMemberPath="Display" SelectedValuePath="Value" />
                                    <TextBlock x:Name="IslandModeStatus" Grid.Column="2" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryText}" Text="悬浮在任务栏上方" TextWrapping="Wrap" />
                                </Grid>
                                <CheckBox x:Name="EditIslandBox" Content="开启编辑浮岛（拖动 / 缩放）"
                                          Checked="EditIslandBox_Changed" Unchecked="EditIslandBox_Changed" Margin="0,14,0,10" />
                                <WrapPanel>
                                    <StackPanel Width="190" Margin="0,0,12,0">
                                        <TextBlock Text="位置预设" />
                                        <ComboBox x:Name="PositionPresetBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectionChanged="PositionPresetBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Width="170" Margin="0,0,12,0">
                                        <TextBlock Text="尺寸预设" />
                                        <ComboBox x:Name="SizePresetBox" DisplayMemberPath="Display" SelectedValuePath="Value"
                                                  SelectionChanged="SizePresetBox_SelectionChanged" />
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,0">
                                        <TextBlock Text="宽度" />
                                        <TextBox x:Name="IslandWidthBox" />
                                    </StackPanel>
                                    <StackPanel Width="130" Margin="0,0,12,0">
                                        <TextBlock Text="高度" />
                                        <TextBox x:Name="IslandHeightBox" />
                                    </StackPanel>
                                    <Button Content="应用自定义尺寸" Click="ApplyIslandSize_Click" VerticalAlignment="Bottom" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="环境 API">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="从环境读取 API" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="扫描系统 / 用户 / 当前进程环境变量以供确认导入。扫描和启动提示都不会自动新增账户；环境变量变化后会动态读取新值。"
                                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,14" />
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="用途：查看当前进程、当前用户和系统范围内可识别的 Provider 凭据。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBlock Text="使用：点“扫描环境”，勾选要导入的项目并确认；默认不会选中或自动导入。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <CheckBox x:Name="EnvironmentAutoImportBox" Content="启动后提示扫描环境变量"
                                          Checked="EnvironmentAutoImportBox_Changed" Unchecked="EnvironmentAutoImportBox_Changed" />
                                <Button Content="扫描环境" Click="ScanEnvironment_Click" HorizontalAlignment="Left" Margin="0,12,0,12" />
                                <TextBlock Text="支持的 Provider 与环境变量" FontWeight="SemiBold" />
                                <DataGrid x:Name="EnvironmentProviderGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Height="260"
                                          Background="{DynamicResource WindowBackground}" BorderThickness="0" Margin="0,6,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding DisplayName}" Width="150" />
                                        <DataGridTextColumn Header="支持能力" Binding="{Binding CapabilityText}" Width="105" />
                                        <DataGridTextColumn Header="匹配方式" Binding="{Binding MatchingMethodText}" Width="260" />
                                        <DataGridTextColumn Header="变量名关键词" Binding="{Binding EnvironmentNameKeywordsText}" Width="130" />
                                        <DataGridTextColumn Header="限制说明" Binding="{Binding Limitations}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Codex 套餐">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="ChatGPT / Codex 套餐余量（实验性）" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="读取 ChatGPT/Codex 套餐的 5 小时与每周余量窗口。此功能使用非公开接口与独立 WebView2 登录会话，可能随网页版变动而失效。"
                                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,14" />
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="风险与确认" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="启用后应用会创建专用 WebView2 登录会话并联网读取套餐余量。登录状态不会写入余额状态或日志；关闭窗口后会话保留在专用 Profile 中。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <CheckBox x:Name="CodexPlanConsentBox" Content="我已了解风险，允许创建登录会话并联网读取"
                                          Checked="CodexPlanConsent_Changed" Unchecked="CodexPlanConsent_Changed" />
                                <Button x:Name="CodexPlanOpenLoginButton" Content="打开登录窗口" Click="CodexPlanOpenLogin_Click" Margin="0,12,0,0" IsEnabled="False" />
                                <TextBlock Text="在登录窗口登录后回到本页点击“读取套餐余量”。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="读取与调度" FontSize="16" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CodexPlanReadButton" Content="读取套餐余量" Click="CodexPlanRead_Click" />
                                    <Button x:Name="CodexPlanResumeButton" Content="重试并恢复" Click="CodexPlanResume_Click" Visibility="Collapsed" Margin="8,0,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="CodexPlanAutoRefreshBox" Content="每 5 分钟自动更新（固定，不可调短；429 后暂停）"
                                          Checked="CodexPlanAutoRefresh_Changed" Unchecked="CodexPlanAutoRefresh_Changed" Margin="0,10,0,4" />
                                <CheckBox x:Name="CodexPlanShowInIslandBox" Content="显示在浮岛（默认轮播与自定义分组）"
                                          Checked="CodexPlanShowInIsland_Changed" Unchecked="CodexPlanShowInIsland_Changed" Margin="0,0,0,10" />
                                <TextBlock x:Name="CodexPlanStatusText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                <TextBlock x:Name="CodexPlanErrorText" Foreground="#FFFF5C6C" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="断开并清除" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="清除专用 WebView2 Profile、登录 Cookie 与所有套餐数据，并停止自动刷新。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,8" />
                                <Button x:Name="CodexPlanDisconnectButton" Content="断开并清除" Click="CodexPlanDisconnect_Click" IsEnabled="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="刷新与通知">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="刷新与通知" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="每个 Provider 使用自己的推荐刷新周期，也可在添加账户时覆盖。遇到 429 会指数退避；余额告警使用 Windows 通知并在失败时回退托盘。"
                                   Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,2,0,14" />
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="重要通知" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="用途：分别控制接近警戒线、到达警戒线和异常变动三类余额提醒。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,6" />
                                <TextBlock Text="使用：勾选需要的事件，再用测试按钮确认当前 Windows 通知通道。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <CheckBox x:Name="NotifyWarning15Box" Content="余额接近警戒线（15%）"
                                          Checked="NotificationSettings_Changed" Unchecked="NotificationSettings_Changed" Margin="0,10,0,4" />
                                <CheckBox x:Name="NotifyCriticalBox" Content="余额到达警戒线"
                                          Checked="NotificationSettings_Changed" Unchecked="NotificationSettings_Changed" Margin="0,0,0,4" />
                                <CheckBox x:Name="NotifyAnomalyBox" Content="余额异常变动"
                                          Checked="NotificationSettings_Changed" Unchecked="NotificationSettings_Changed" Margin="0,0,0,10" />
                                <TextBlock x:Name="NotificationChannelStatusText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" />
                                <TextBlock Text="Windows 的专注助手、通知权限和重要通知设置仍然优先；应用无法绕过系统策略。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <Button Content="发送测试通知" Click="SendTestNotification_Click" />
                                    <Button Content="打开 Windows 通知设置" Click="OpenNotificationSettings_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="运行" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="关闭主窗口后应用继续驻留托盘；全屏应用占满显示器时自动隐藏浮岛，退出全屏后恢复。"
                                           Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}" Text="就绪" TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="立即刷新全部账户" Click="Refresh_Click" />
                <Button x:Name="IslandButton" Content="隐藏任务栏浮岛" Click="ToggleIsland_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
