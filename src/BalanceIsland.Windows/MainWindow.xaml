<Window x:Class="BalanceIsland.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Balance Island" Width="940" Height="700" MinWidth="780" MinHeight="560"
        Background="{DynamicResource WindowBackground}" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Balance Island" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Windows 任务栏 AI API 余额监控 · v0.1.5"
                       Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" CornerRadius="10"
                Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.8*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Provider" />
                    <ComboBox x:Name="ProviderBox" DisplayMemberPath="Display" SelectedValuePath="Value" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="账户备注" />
                    <TextBox x:Name="LabelBox" ToolTip="留空时显示 Key 后四位" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="API Key" />
                    <PasswordBox x:Name="ApiKeyBox" Padding="8,6" Margin="0,4,0,10" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="手动余额" />
                    <TextBox x:Name="ManualBalanceBox" ToolTip="可选" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="刷新分钟" />
                    <TextBox x:Name="RefreshMinutesBox" Text="0" ToolTip="0 使用 Provider 建议值" />
                </StackPanel>
                <Button Grid.Column="5" Content="添加账户" Click="AddAccount_Click"
                        VerticalAlignment="Center" MinWidth="94" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBackground}" CornerRadius="10"
                Padding="12,8" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="IslandModeSelectorColumn" Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IslandModeLabel" Grid.Column="0" Text="浮岛显示模式"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="IslandModeBox" Grid.Column="1" Margin="12,0,12,0"
                          DisplayMemberPath="Display" SelectedValuePath="Value" />
                <TextBlock x:Name="IslandModeStatus" Grid.Column="2" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="悬浮在任务栏上方" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="8">
            <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      Background="Transparent" BorderThickness="0" AlternationCount="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Provider" Binding="{Binding Provider}" Width="130" />
                    <DataGridTextColumn Header="账户" Binding="{Binding Label}" Width="135" />
                    <DataGridTextColumn Header="余额/状态" Binding="{Binding Primary}" Width="150" />
                    <DataGridTextColumn Header="详情" Binding="{Binding Secondary}" Width="*" />
                    <DataGridTextColumn Header="刷新时间" Binding="{Binding Updated}" Width="145" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryText}" Text="就绪" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="删除所选" Click="DeleteSelected_Click" />
                <Button Content="立即刷新" Click="Refresh_Click" />
                <Button x:Name="IslandButton" Content="隐藏任务栏浮岛" Click="ToggleIsland_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
