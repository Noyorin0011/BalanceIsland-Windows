<Application x:Class="BalanceIsland.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#101419" />
        <SolidColorBrush x:Key="CardBackground" Color="#1A2027" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F3F6F9" />
        <SolidColorBrush x:Key="SecondaryText" Color="#AAB4BF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6EA8FE" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </Application.Resources>
</Application>
